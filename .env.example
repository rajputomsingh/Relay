# Local development configuration. Copy to .env:
#   cp .env.example .env
# Values already exported in the shell take precedence over this file.

# Required. One of: development, test, production.
APP_ENV=development

# Optional. HTTP listen port (1-65535). Default: 8080.
PORT=8080

# Required. MongoDB connection string, e.g. mongodb://localhost:27017.
MONGODB_URI=
# Optional. Database name. Default: relay.
MONGODB_DATABASE=relay

# Required. API key used to authenticate API requests.
# Must contain at least 32 characters.
RELAY_API_KEY=

# Optional. Used only to bootstrap a default endpoint on first run
# when the endpoints collection is empty. After bootstrap, endpoints
# are managed via the API.
RELAY_WEBHOOK_URL=

# Optional. When true, RELAY_WEBHOOK_URL may target private, loopback,
# or link-local addresses (needed for local development webhooks).
# Default: false (SSRF protection).
RELAY_WEBHOOK_URL_ALLOW_PRIVATE=false

# Optional. Seconds between delivery worker polls (1-60). Default: 2.
RELAY_WORKER_POLL_SECONDS=2
# Optional. Max delivery attempts per event (1-20). Default: 8.
RELAY_MAX_DELIVERY_ATTEMPTS=8

# Number of deliveries processed in parallel by each Relay instance.
# Higher values increase throughput at the cost of more concurrent
# outbound HTTP requests. Range: 1-32. Default: 4.
RELAY_WORKER_CONCURRENCY=4

# Optional. When set, outbound webhook requests are signed with
# HMAC-SHA256. Must be at least 32 characters. Keep this value out of
# version control.
RELAY_WEBHOOK_SIGNING_SECRET=
