# Local configuration. Never commit.
.env
.env.*
!.env.example

# Local secrets
secrets/
monitoring/secrets/

# Go binaries and test artifacts
*.exe
*.test
coverage.out

# IDE configuration
.vscode/
.idea/

# Benchmark harness output
# JSON per-run files are exploratory; only the summary report
# and the harness itself are version-controlled.
bench/results/*.json
bench/results/summary.md

# PyPI credentials — never commit
.pypi-token
.pypirc
.netrc
