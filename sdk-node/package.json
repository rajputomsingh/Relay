{
  "name": "@rajputomsingh/relay-node",
  "version": "2.0.0",
  "description": "Official Node.js SDK for Relay webhook delivery",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RELAY_TEST_BASE_URL=http://localhost:8080 RELAY_TEST_API_KEY=$RELAY_API_KEY vitest run integration",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webhooks",
    "relay",
    "infrastructure"
  ],
  "author": "Om Singh Chouhan",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.9",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}